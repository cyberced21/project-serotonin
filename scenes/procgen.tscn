[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/procgen/procgen_world.gd" id="1_world"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="2_player"]
[ext_resource type="Script" path="res://scripts/hud.gd" id="3_hud"]
[ext_resource type="Shader" path="res://shaders/terrain.gdshader" id="4_terrain_shader"]
[ext_resource type="Terrain3DAssets" path="res://materials/terrain_assets.tres" id="5_terrain_assets"]
[ext_resource type="Script" path="res://scripts/day_night_sky.gd" id="6_sky"]
[ext_resource type="Environment" path="res://materials/world_environment.tres" id="7_sky_shader_env"]
[ext_resource type="Script" path="res://scripts/upgrade_panel.gd" id="8_panel"]

[sub_resource type="Terrain3DMaterial" id="Terrain3DMaterial_lowpoly"]
shader_override_enabled = true
shader_override = ExtResource("4_terrain_shader")
show_checkered = false
_shader_parameters = {
&"sand_height": -0.05
}

[node name="Procgen" type="Node3D"]
physics_interpolation_mode = 2
script = ExtResource("1_world")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("7_sky_shader_env")

[node name="Sun" type="DirectionalLight3D" parent="."]
rotation = Vector3(-0.9, 0.6, 0)
shadow_enabled = true
directional_shadow_max_distance = 60.0

[node name="Terrain3D" type="Terrain3D" parent="." groups=["terrain"]]
collision_mode = 3
material = SubResource("Terrain3DMaterial_lowpoly")
assets = ExtResource("5_terrain_assets")

[node name="Sky" type="Node" parent="." node_paths=PackedStringArray("sun", "environment")]
script = ExtResource("6_sky")
sun = NodePath("../Sun")
environment = NodePath("../WorldEnvironment")

[node name="Player" parent="." instance=ExtResource("2_player")]
position = Vector3(0, 0.1, 0)

[node name="HUD" type="CanvasLayer" parent="."]
script = ExtResource("3_hud")

[node name="UpgradePanel" type="CanvasLayer" parent="."]
script = ExtResource("8_panel")
