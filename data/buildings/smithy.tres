[gd_resource type="Resource" script_class="BuildingDef" format=3]

[ext_resource type="Script" path="res://scripts/building_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/building_tier.gd" id="2_tier"]
[ext_resource type="PackedScene" path="res://models/village/smithy.glb" id="3_model"]
[ext_resource type="Script" path="res://scripts/tier_effect.gd" id="4_effect"]

[sub_resource type="Resource" id="Effect_2_0"]
script = ExtResource("4_effect")
stat = &"double_hit_chance"
value = 0.2
text = "Sharper tools: 20% chance a hit counts twice"

[sub_resource type="Resource" id="Effect_3_0"]
script = ExtResource("4_effect")
stat = &"double_hit_chance"
value = 0.4
text = "Sharper tools: 40% chance a hit counts twice"

[sub_resource type="Resource" id="Effect_4_0"]
script = ExtResource("4_effect")
stat = &"double_hit_chance"
value = 0.4
text = "Sharper tools: 40% chance a hit counts twice"

[sub_resource type="Resource" id="Effect_4_1"]
script = ExtResource("4_effect")
stat = &"streak_double"
value = 3.0
text = "Crystal edges: every 3rd hit in a row counts twice"

[sub_resource type="Resource" id="Tier_1"]
script = ExtResource("2_tier")
name = "Fire Pit"
lines = PackedStringArray("An anvil on a stump and a fire in a hole. It's a start.", "Copper. Bring me copper, and some logs for a roof. I'm tired of rust.", "Every hammer stroke out here, the birds complain.")

[sub_resource type="Resource" id="Tier_2"]
script = ExtResource("2_tier")
name = "Stone Forge"
cost = Dictionary[StringName, int]({
&"wood": 10,
&"ore": 20
})
lines = PackedStringArray("A real forge! Hot enough to work properly now.", "Iron next. There's a dark seam in the rocks east of here, if your pick's up to it.", "Walls next. Bellows. A sign, so folk know where to find me.", "And coal. Logs won't get a forge hot enough for proper iron. There's a black seam out by the pass.")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_2_0")])

[sub_resource type="Resource" id="Tier_3"]
script = ExtResource("2_tier")
name = "Smithy"
cost = Dictionary[StringName, int]({
&"wood": 20,
&"ore": 30,
&"iron": 20,
&"coal": 10
})
lines = PackedStringArray("Look at that chimney smoke. That's the smell of honest work.", "Bellows, grindstone, quench trough. Couldn't ask for more.", "One day I'll forge you something special. When I know what.", "They say there's crystal at the bottom of the old quarry, west past the peak. Bring me some and I'll put an edge on your tools you won't believe.")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_3_0")])

[sub_resource type="Resource" id="Tier_4"]
script = ExtResource("2_tier")
name = "Crystal Forge"
cost = Dictionary[StringName, int]({
&"iron": 20,
&"coal": 20,
&"gold": 10,
&"crystal": 8
})
hall_tier = 3
lines = PackedStringArray("Crystal in the quench, crystal on the edge. Listen to it ring!", "Down at the bottom of the quarry, you said? Worth every step back up.", "No more pretty words from me. Go and hit something.")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_4_0"), SubResource("Effect_4_1")])

[resource]
script = ExtResource("1_def")
id = &"smithy"
display_name = "Smithy"
model = ExtResource("3_model")
tiers = Array[ExtResource("2_tier")]([SubResource("Tier_1"), SubResource("Tier_2"), SubResource("Tier_3"), SubResource("Tier_4")])
villager_name = "Greta"
villager_role = "Smith"
capped_line = "Town hall's not grand enough yet, says the mayor. Can't have the smithy outshining it."
night_lines = PackedStringArray("Forge is banked for the night, but I'm up. What do you need?", "Can't sleep with the smell of iron in my nose. Come in, come in.")
