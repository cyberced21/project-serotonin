[gd_resource type="Resource" script_class="BuildingDef" format=3]

[ext_resource type="Script" path="res://scripts/building_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/building_tier.gd" id="2_tier"]
[ext_resource type="PackedScene" path="res://models/village/prospector_cottage.gltf" id="3_model"]
[ext_resource type="Script" path="res://scripts/tier_effect.gd" id="4_effect"]
[ext_resource type="Script" path="res://scripts/addon_def.gd" id="90_addon"]

[sub_resource type="Resource" id="Effect_2_0"]
script = ExtResource("4_effect")
stat = &"extra_ore"
value = 1.0
text = "+1 ore from every rock and vein"

[sub_resource type="Resource" id="Effect_3_0"]
script = ExtResource("4_effect")
stat = &"extra_ore"
value = 1.0
text = "+1 ore from every rock and vein"

[sub_resource type="Resource" id="Effect_3_1"]
script = ExtResource("4_effect")
stat = &"rock_regrow"
value = 0.3
text = "Rocks and veins grow back 30% faster"

[sub_resource type="Resource" id="Tier_1"]
script = ExtResource("2_tier")
name = "Cottage"
lines = PackedStringArray("Coal by the pass, gold up in the foothills of the peak. You'll need a good arm for both.", "Sorting rock is half the job. The other half is carrying it home.", "Pine burns long and hot, and it makes good straight beams besides.", "A shed for sorting, that's my first wish. Coal and pine to build it, and some copper to sort.")

[sub_resource type="Resource" id="Tier_2"]
script = ExtResource("2_tier")
name = "Assay Shed"
cost = Dictionary[StringName, int]({
&"pine": 10,
&"ore": 15,
&"coal": 15
})
lines = PackedStringArray("With a proper sorting table I can show you where the good stuff sits. You'll get more out of every rock.", "Gold, now. Gold for the scales and the crucible. Bring me some and I'll open an assay office.", "Coal for the crucible and iron for the frame, too. Assaying isn't cheap.")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_2_0")])

[sub_resource type="Resource" id="Tier_3"]
script = ExtResource("2_tier")
name = "Assay Office"
cost = Dictionary[StringName, int]({
&"pine": 20,
&"iron": 10,
&"coal": 20,
&"gold": 10
})
lines = PackedStringArray("Scales, crucible, the lot! I can read a hillside like a book now.", "I've marked the best seams on my map. Knock one out and there's always another coming through.", "Gold in the village! The mayor keeps coming by to 'inspect' it.")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_3_0"), SubResource("Effect_3_1")])

[sub_resource type="Resource" id="AddonEffect_orecart"]
script = ExtResource("4_effect")
stat = &"mine_regrow"
value = 0.2
text = "Mine seams grow back 20% faster"

[sub_resource type="Resource" id="Addon_orecart"]
script = ExtResource("90_addon")
id = &"orecart"
slot = 1
name = "Ore cart"
blurb = "A cart and a short run of rail by the door, heaped with ore."
cost = Dictionary[StringName, int]({
&"iron": 12,
&"wood": 15
})
effects = Array[ExtResource("4_effect")]([SubResource("AddonEffect_orecart")])

[sub_resource type="Resource" id="AddonEffect_lamproom"]
script = ExtResource("4_effect")
stat = &"mine_hint"
value = 1.0
text = "A dig face shows what's behind it"

[sub_resource type="Resource" id="Addon_lamproom"]
script = ExtResource("90_addon")
id = &"lamproom"
slot = 1
name = "Lamp room"
blurb = "A lean-to of hanging lamps over a charging bench."
cost = Dictionary[StringName, int]({
&"wood": 15,
&"coal": 8,
&"iron": 4
})
effects = Array[ExtResource("4_effect")]([SubResource("AddonEffect_lamproom")])

[sub_resource type="Resource" id="AddonEffect_assay"]
script = ExtResource("4_effect")
stat = &"mine_finds"
value = 1.0
text = "Geodes and fossils turn up twice as often"

[sub_resource type="Resource" id="Addon_assay"]
script = ExtResource("90_addon")
id = &"assay"
slot = 2
name = "Assay table"
blurb = "Scales, loupes and labelled jars of samples."
cost = Dictionary[StringName, int]({
&"oak": 12,
&"gold": 3,
&"crystal": 2
})
effects = Array[ExtResource("4_effect")]([SubResource("AddonEffect_assay")])

[sub_resource type="Resource" id="AddonEffect_survey"]
script = ExtResource("4_effect")
stat = &"mine_survey"
value = 1.0
text = "Unopened cells show their ore on the mine map"

[sub_resource type="Resource" id="Addon_survey"]
script = ExtResource("90_addon")
id = &"survey"
