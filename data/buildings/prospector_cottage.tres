cost = Dictionary[StringName, int]({
&"wood": 15,
&"iron": 8,
&"gold": 2
})
effects = Array[ExtResource("4_effect")]([SubResource("AddonEffect_survey")])

[resource]
script = ExtResource("1_def")
id = &"prospector_cottage"
display_name = "Edda's Cottage"
model = ExtResource("3_model")
tiers = Array[ExtResource("2_tier")]([SubResource("Tier_1"), SubResource("Tier_2"), SubResource("Tier_3")])
villager_name = "Edda"
villager_role = "Prospector"
capped_line = ""
night_lines = PackedStringArray("Lamp's still lit, I'm still sorting. What've you found?", "The stars are out. Good night for walking the hills, if you mind your footing.")
looks = PackedStringArray("LookMaps|the maps|Every seam I've followed, every one that ran dry. The dry ones teach you more.", "LookSamples|the sample bottles|Copper, iron, a little gold dust. And that one's just a pretty pebble. I keep it anyway.", "LookLedger|the assay ledger|Weights, grades, dates. Dull to anyone but me, and I could read it all night.")
addons = Array[ExtResource("90_addon")]([SubResource("Addon_orecart"), SubResource("Addon_lamproom"), SubResource("Addon_assay"), SubResource("Addon_survey")])
addon_slots = PackedInt32Array(2, 3)
