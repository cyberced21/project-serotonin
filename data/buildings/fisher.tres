[gd_resource type="Resource" script_class="BuildingDef" format=3]

[ext_resource type="Script" path="res://scripts/building_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/building_tier.gd" id="2_tier"]
[ext_resource type="PackedScene" path="res://models/village/fisher.glb" id="3_model"]
[ext_resource type="Script" path="res://scripts/tier_effect.gd" id="4_effect"]

[sub_resource type="Resource" id="Effect_2_0"]
script = ExtResource("4_effect")
stat = &"fish_calm"
value = 0.25
text = "Calmer fish: they spook from 25% closer"

[sub_resource type="Resource" id="Effect_3_0"]
script = ExtResource("4_effect")
stat = &"fish_calm"
value = 0.25
text = "Calmer fish: they spook from 25% closer"

[sub_resource type="Resource" id="Effect_3_1"]
script = ExtResource("4_effect")
stat = &"bonus_fish_chance"
value = 0.25
text = "25% chance a speared fish counts twice"

[sub_resource type="Resource" id="Effect_3_2"]
script = ExtResource("4_effect")
stat = &"line_notches"
value = 1.0
text = "Stronger line: one more mistake before it snaps"

[sub_resource type="Resource" id="Tier_1"]
script = ExtResource("2_tier")
name = "Tent & Rack"
lines = PackedStringArray("Fish dry on the rack, I sleep in the tent. Some nights I mix them up.", "Perch, that's the trick. Plenty of perch, and some logs for a proper shack.", "Shh. You're stepping too loud. They can hear you, you know.", "Fish are dozy at dawn and dusk. That's when I do my best work.")

[sub_resource type="Resource" id="Tier_2"]
script = ExtResource("2_tier")
name = "Stilt Shack"
cost = Dictionary[StringName, int]({
&"wood": 10,
&"perch": 10
})
lines = PackedStringArray("Up on stilts, dry as a bone. Well. Drier.", "A rod lets you fish from the bank. Watch the float: little twitches are teasing, it's the dunk you strike on.", "Trout are clever. Pike are cleverer, and they only live in the pond over the hill.", "A dock, that's my dream. Fish right off the end of it.")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_2_0")])

[sub_resource type="Resource" id="Tier_3"]
script = ExtResource("2_tier")
name = "Shack & Dock"
cost = Dictionary[StringName, int]({
&"wood": 25,
&"trout": 8,
&"pike": 3,
&"char": 2
})
lines = PackedStringArray("Pike from the other pond, in my hut! You're a legend.", "Come sit on the dock. Fish don't bite any better, but the view's nice.", "Got a boat now, too. Haven't worked out where to row it.", "Char from the deep middle of the lake. You'll want a rod for those, the spear won't reach.")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_3_0"), SubResource("Effect_3_1"), SubResource("Effect_3_2")])

[resource]
script = ExtResource("1_def")
id = &"fisher"
display_name = "Fisher's Hut"
model = ExtResource("3_model")
tiers = Array[ExtResource("2_tier")]([SubResource("Tier_1"), SubResource("Tier_2"), SubResource("Tier_3")])
villager_name = "Ollie"
villager_role = "Fisher"
capped_line = "Can't build bigger than the town hall, the mayor says. Something about appearances."
night_lines = PackedStringArray("Night fishing? Ha. The fish are smarter than that. What's up?", "Lantern's lit if you need it. Mind the dock in the dark.")
