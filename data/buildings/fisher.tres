[gd_resource type="Resource" script_class="BuildingDef" format=3]

[ext_resource type="Script" path="res://scripts/building_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/building_tier.gd" id="2_tier"]
[ext_resource type="PackedScene" path="res://models/village/fisher.gltf" id="3_model"]
[ext_resource type="Script" path="res://scripts/tier_effect.gd" id="4_effect"]
[ext_resource type="Script" path="res://scripts/addon_def.gd" id="9_addon"]

[sub_resource type="Resource" id="Effect_2_0"]
script = ExtResource("4_effect")
stat = &"fish_calm"
value = 0.25
text = "Calmer fish: they spook from 25% closer"

[sub_resource type="Resource" id="Effect_3_0"]
script = ExtResource("4_effect")
stat = &"fish_calm"
value = 0.25
text = "Calmer fish: they spook from 25% closer"

[sub_resource type="Resource" id="Effect_3_1"]
script = ExtResource("4_effect")
stat = &"bonus_fish_chance"
value = 0.25
text = "25% chance a fish counts twice"

[sub_resource type="Resource" id="Effect_3_2"]
script = ExtResource("4_effect")
stat = &"strike_window"
value = 0.25
text = "Sharper eyes: 25% longer to pull on the rod, 25% wider spear thrusts"

[sub_resource type="Resource" id="Tier_1"]
script = ExtResource("2_tier")
name = "Tent & Rack"
lines = PackedStringArray("Fish dry on the rack, I sleep in the tent. Some nights I mix them up.", "Perch, that's the trick. Plenty of perch, and some logs for a proper shack.", "Shh. You're stepping too loud. They can hear you, you know.", "Fish are dozy at dawn and dusk. That's when I do my best work.")

[sub_resource type="Resource" id="Tier_2"]
script = ExtResource("2_tier")
name = "Stilt Shack"
cost = Dictionary[StringName, int]({
&"wood": 10,
&"perch": 10
})
lines = PackedStringArray("Up on stilts, dry as a bone. Well. Drier.", "A rod lets you fish from the bank. Watch the float: little twitches are teasing. When it goes under, pull!", "Trout are clever. Pike are cleverer, and they only live in the pond over the hill.", "A dock, that's my dream. Fish right off the end of it.")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_2_0")])

[sub_resource type="Resource" id="Tier_3"]
script = ExtResource("2_tier")
name = "Shack & Dock"
cost = Dictionary[StringName, int]({
&"wood": 25,
&"trout": 8,
&"pike": 3,
&"char": 2
})
lines = PackedStringArray("Pike from the other pond, in my hut! You're a legend.", "Come sit on the dock. Fish don't bite any better, but the view's nice.", "Got a boat now, too. Haven't worked out where to row it.", "Char live in the deep middle of the lake. A rod reaches them, or wade in at dawn or dusk when they come up to feed.")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_3_0"), SubResource("Effect_3_1"), SubResource("Effect_3_2")])

[sub_resource type="Resource" id="AddonEffect_smokehouse"]
script = ExtResource("4_effect")
stat = &"bonus_fish_chance"
value = 0.1
text = "+10% chance a speared fish counts twice"

[sub_resource type="Resource" id="Addon_smokehouse"]
script = ExtResource("9_addon")
id = &"smokehouse"
name = "Smokehouse"
blurb = "A little plank shed, smoke curling out of it."
cost = Dictionary[StringName, int]({
&"wood": 20,
&"oak": 10
})
effects = Array[ExtResource("4_effect")]([SubResource("AddonEffect_smokehouse")])

[sub_resource type="Resource" id="AddonEffect_lookout"]
script = ExtResource("4_effect")
stat = &"fish_calm"
value = 0.1
text = "Fish are 10% calmer"

[sub_resource type="Resource" id="Addon_lookout"]
script = ExtResource("9_addon")
id = &"lookout"
name = "Lookout perch"
blurb = "Up on its legs, Ollie can see where the fish are."
cost = Dictionary[StringName, int]({
&"pine": 15,
&"wood": 10
})
effects = Array[ExtResource("4_effect")]([SubResource("AddonEffect_lookout")])

[sub_resource type="Resource" id="AddonEffect_eeltraps"]
script = ExtResource("4_effect")
stat = &"eel_trap"
value = 1.0
text = "A fish waiting in the trap each morning"

[sub_resource type="Resource" id="Addon_eeltraps"]
script = ExtResource("9_addon")
id = &"eeltraps"
slot = 2
name = "Eel traps"
blurb = "Wicker traps on a rope off the jetty."
cost = Dictionary[StringName, int]({
&"birch": 15,
&"wood": 10
})
effects = Array[ExtResource("4_effect")]([SubResource("AddonEffect_eeltraps")])

[sub_resource type="Resource" id="AddonEffect_jettylantern"]
script = ExtResource("4_effect")
stat = &"fish_calm_night"
value = 0.3
text = "Fish are calmer at night"

[sub_resource type="Resource" id="Addon_jettylantern"]
script = ExtResource("9_addon")
id = &"jettylantern"
slot = 2
name = "Jetty lantern"
blurb = "A lantern on a tall pole at the water's edge."
cost = Dictionary[StringName, int]({
&"wood": 12,
&"iron": 6,
&"coal": 4
})
effects = Array[ExtResource("4_effect")]([SubResource("AddonEffect_jettylantern")])

[resource]
script = ExtResource("1_def")
id = &"fisher"
display_name = "Fisher's Hut"
model = ExtResource("3_model")
tiers = Array[ExtResource("2_tier")]([SubResource("Tier_1"), SubResource("Tier_2"), SubResource("Tier_3")])
villager_name = "Ollie"
villager_role = "Fisher"
capped_line = "Can't build bigger than the town hall, the mayor says. Something about appearances."
night_lines = PackedStringArray("Night fishing? Ha. The fish are smarter than that. What's up?", "Lantern's lit if you need it. Mind the dock in the dark.")
looks = PackedStringArray("LookRod|the old willow rod|My first rod. Caught a perch the size of my hand with it and cried with joy. I was nine. Or thirty.")
addons = Array[ExtResource("9_addon")]([SubResource("Addon_smokehouse"), SubResource("Addon_lookout"), SubResource("Addon_eeltraps"), SubResource("Addon_jettylantern")])
addon_slots = PackedInt32Array(2, 3)
