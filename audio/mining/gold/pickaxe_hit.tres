[gd_resource type="Resource" script_class="SoundLayers" format=3]

[ext_resource type="Script" path="res://scripts/sound_layers.gd" id="1_layers"]
[ext_resource type="Script" path="res://scripts/sound_layer.gd" id="2_layer"]
[ext_resource type="AudioStream" path="res://audio/mining/sfx/hit_crack.tres" id="s0"]
[ext_resource type="AudioStream" path="res://audio/mining/sfx/hit_gravel.tres" id="s1"]
[ext_resource type="AudioStream" path="res://audio/mining/sfx/gold/hit_thump.tres" id="s2"]
[ext_resource type="AudioStream" path="res://audio/mining/sfx/gold/hit_tink.tres" id="s3"]

[sub_resource type="Resource" id="Layer_crack"]
script = ExtResource("2_layer")
stream = ExtResource("s0")
pitch_jitter = 0.06
pitch = 0.85
resource_name = "crack"

[sub_resource type="Resource" id="Layer_tink"]
script = ExtResource("2_layer")
stream = ExtResource("s3")
volume_db = -8.0
pitch_jitter = 0.06
resource_name = "tink"

[sub_resource type="Resource" id="Layer_thump"]
script = ExtResource("2_layer")
stream = ExtResource("s2")
volume_db = -6.0
pitch_jitter = 0.05
follows_pitch = false
pitch = 0.75
resource_name = "thump"

[sub_resource type="Resource" id="Layer_gravel"]
script = ExtResource("2_layer")
stream = ExtResource("s1")
delay = 0.07
volume_db = -11.0
pitch_jitter = 0.1
resource_name = "gravel"

[resource]
script = ExtResource("1_layers")
layers = Array[ExtResource("2_layer")]([SubResource("Layer_crack"), SubResource("Layer_tink"), SubResource("Layer_thump"), SubResource("Layer_gravel")])
