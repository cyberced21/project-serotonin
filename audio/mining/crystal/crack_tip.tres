[gd_resource type="Resource" script_class="SoundLayers" format=3]

[ext_resource type="Script" path="res://scripts/sound_layers.gd" id="1_layers"]
[ext_resource type="Script" path="res://scripts/sound_layer.gd" id="2_layer"]
[ext_resource type="AudioStream" path="res://audio/mining/sfx/crystal/crack_split.tres" id="s0"]
[ext_resource type="AudioStream" path="res://audio/mining/sfx/hit_gravel.tres" id="s1"]
[ext_resource type="AudioStream" path="res://audio/mining/sfx/crystal/hit_clink.tres" id="s2"]

[sub_resource type="Resource" id="Layer_split"]
script = ExtResource("2_layer")
stream = ExtResource("s0")
volume_db = 2.5
pitch_jitter = 0.05
pitch = 0.9
resource_name = "split"

[sub_resource type="Resource" id="Layer_trickle"]
script = ExtResource("2_layer")
stream = ExtResource("s1")
delay = 0.05
volume_db = -12.0
pitch_jitter = 0.1
pitch = 1.2
resource_name = "trickle"

[sub_resource type="Resource" id="Layer_clink"]
script = ExtResource("2_layer")
stream = ExtResource("s2")
volume_db = -3.0
pitch_jitter = 0.03
pitch = 1.1
resource_name = "clink"

[resource]
script = ExtResource("1_layers")
layers = Array[ExtResource("2_layer")]([SubResource("Layer_split"), SubResource("Layer_trickle"), SubResource("Layer_clink")])
