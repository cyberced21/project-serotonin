pitch_jitter = 0.12
pitch = 1.6
resource_name = "tick"

[resource]
script = ExtResource("1_layers")
layers = Array[ExtResource("2_layer")]([SubResource("Layer_tick")])
bus = &"Debris"
unit_size = 2.5
max_distance = 30.0
