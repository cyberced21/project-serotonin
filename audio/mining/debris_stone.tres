[gd_resource type="Resource" script_class="SoundLayers" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/sound_layers.gd" id="1_layers"]
[ext_resource type="Script" path="res://scripts/sound_layer.gd" id="2_layer"]
[ext_resource type="AudioStream" path="res://audio/footsteps/rock.tres" id="3_rock"]

[sub_resource type="Resource" id="Layer_tick"]
script = ExtResource("2_layer")
stream = ExtResource("3_rock")
