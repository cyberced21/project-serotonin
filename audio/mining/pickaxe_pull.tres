[gd_resource type="Resource" script_class="SoundLayers" format=3]

[ext_resource type="Script" path="res://scripts/sound_layers.gd" id="1_layers"]
[ext_resource type="Script" path="res://scripts/sound_layer.gd" id="2_layer"]
[ext_resource type="AudioStream" path="res://audio/mining/sfx/pull_pebbles.tres" id="s0"]
[ext_resource type="AudioStream" path="res://audio/mining/sfx/pull_scrape.tres" id="s1"]

[sub_resource type="Resource" id="Layer_scrape"]
script = ExtResource("2_layer")
stream = ExtResource("s1")
volume_db = -6.0
pitch_jitter = 0.06
pitch = 0.9
resource_name = "scrape"

[sub_resource type="Resource" id="Layer_pebbles"]
script = ExtResource("2_layer")
stream = ExtResource("s0")
delay = 0.05
volume_db = -10.0
pitch_jitter = 0.1
resource_name = "pebbles"

[resource]
script = ExtResource("1_layers")
layers = Array[ExtResource("2_layer")]([SubResource("Layer_scrape"), SubResource("Layer_pebbles")])
