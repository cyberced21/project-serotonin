[gd_resource type="Resource" script_class="SoundLayers" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/sound_layers.gd" id="1_layers"]
[ext_resource type="Script" path="res://scripts/sound_layer.gd" id="2_layer"]
[ext_resource type="AudioStream" path="res://audio/stone_hit.tres" id="3_hit"]
[ext_resource type="AudioStream" path="res://audio/footsteps/rock.tres" id="4_gravel"]

[sub_resource type="Resource" id="Layer_split"]
script = ExtResource("2_layer")
stream = ExtResource("3_hit")
volume_db = -3.0
pitch_jitter = 0.04
pitch = 1.5
resource_name = "split"

[sub_resource type="Resource" id="Layer_trickle"]
script = ExtResource("2_layer")
stream = ExtResource("4_gravel")
delay = 0.06
volume_db = -9.0
pitch_jitter = 0.1
pitch = 1.5
resource_name = "trickle"

[resource]
script = ExtResource("1_layers")
layers = Array[ExtResource("2_layer")]([SubResource("Layer_split"), SubResource("Layer_trickle")])
