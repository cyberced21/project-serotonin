[gd_resource type="Resource" script_class="SoundLayers" format=3]

[ext_resource type="Script" path="res://scripts/sound_layers.gd" id="1_layers"]
[ext_resource type="Script" path="res://scripts/sound_layer.gd" id="2_layer"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/land_boom.tres" id="s0"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/pine/land_slump.tres" id="s1"]

[sub_resource type="Resource" id="Layer_slump"]
script = ExtResource("2_layer")
stream = ExtResource("s1")
pitch = 1.0
pitch_jitter = 0.05
resource_name = "slump"

[sub_resource type="Resource" id="Layer_boom"]
script = ExtResource("2_layer")
stream = ExtResource("s0")
volume_db = -5.0
pitch = 1.0
follows_pitch = false
resource_name = "boom"

[resource]
script = ExtResource("1_layers")
layers = Array[ExtResource("2_layer")]([SubResource("Layer_slump"), SubResource("Layer_boom")])
unit_size = 8.0
max_distance = 80.0
