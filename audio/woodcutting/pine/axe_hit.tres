[gd_resource type="Resource" script_class="SoundLayers" format=3]

[ext_resource type="Script" path="res://scripts/sound_layers.gd" id="1_layers"]
[ext_resource type="Script" path="res://scripts/sound_layer.gd" id="2_layer"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/chip_scatter.tres" id="s0"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/chop_bite.tres" id="s1"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/pine/chop_thunk.tres" id="s2"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/pine/chop_bloom.tres" id="s3"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/pine/chop_punch.tres" id="s4"]

[sub_resource type="Resource" id="Layer_thunk"]
script = ExtResource("2_layer")
stream = ExtResource("s2")
pitch = 1.0
pitch_jitter = 0.05
resource_name = "thunk"

[sub_resource type="Resource" id="Layer_bite"]
script = ExtResource("2_layer")
stream = ExtResource("s1")
volume_db = -5.0
pitch_jitter = 0.08
pitch = 1.0
resource_name = "bite"

[sub_resource type="Resource" id="Layer_chips"]
script = ExtResource("2_layer")
stream = ExtResource("s0")
delay = 0.05
volume_db = -15.0
pitch_jitter = 0.1
resource_name = "chips"

[sub_resource type="Resource" id="Layer_bloom"]
script = ExtResource("2_layer")
stream = ExtResource("s3")
volume_db = -5.0
pitch_jitter = 0.05
follows_pitch = false
resource_name = "bloom"

[sub_resource type="Resource" id="Layer_punch"]
script = ExtResource("2_layer")
stream = ExtResource("s4")
pitch_jitter = 0.04
follows_pitch = false
resource_name = "punch"

[resource]
script = ExtResource("1_layers")
layers = Array[ExtResource("2_layer")]([SubResource("Layer_thunk"), SubResource("Layer_bite"), SubResource("Layer_chips"), SubResource("Layer_bloom"), SubResource("Layer_punch")])
