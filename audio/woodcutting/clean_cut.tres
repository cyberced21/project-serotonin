[gd_resource type="Resource" script_class="SoundLayers" format=3]

[ext_resource type="Script" path="res://scripts/sound_layers.gd" id="1_layers"]
[ext_resource type="Script" path="res://scripts/sound_layer.gd" id="2_layer"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/clean_crack.tres" id="s0"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/fibre_tear.tres" id="s1"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/chop_bloom.tres" id="s2"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/chop_punch.tres" id="s3"]

[sub_resource type="Resource" id="Layer_snap"]
script = ExtResource("2_layer")
stream = ExtResource("s0")
volume_db = -3.0
pitch_jitter = 0.06
pitch = 1.0
resource_name = "snap"

[sub_resource type="Resource" id="Layer_crackle"]
script = ExtResource("2_layer")
stream = ExtResource("s1")
delay = 0.03
volume_db = -14.0
pitch_jitter = 0.1
resource_name = "crackle"

[sub_resource type="Resource" id="Layer_bloom"]
script = ExtResource("2_layer")
stream = ExtResource("s2")
volume_db = -1.0
pitch_jitter = 0.04
follows_pitch = false
pitch = 0.85
resource_name = "bloom"

[sub_resource type="Resource" id="Layer_punch"]
script = ExtResource("2_layer")
stream = ExtResource("s3")
pitch_jitter = 0.04
follows_pitch = false
pitch = 0.85
resource_name = "punch"

[resource]
script = ExtResource("1_layers")
layers = Array[ExtResource("2_layer")]([SubResource("Layer_snap"), SubResource("Layer_crackle"), SubResource("Layer_bloom"), SubResource("Layer_punch")])
