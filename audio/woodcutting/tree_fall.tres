[gd_resource type="Resource" script_class="SoundLayers" format=3]

[ext_resource type="Script" path="res://scripts/sound_layers.gd" id="1_layers"]
[ext_resource type="Script" path="res://scripts/sound_layer.gd" id="2_layer"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/crown_rush.tres" id="s0"]
[ext_resource type="AudioStream" path="res://audio/woodcutting/sfx/fibre_tear.tres" id="s1"]

[sub_resource type="Resource" id="Layer_tear"]
script = ExtResource("2_layer")
stream = ExtResource("s1")
pitch = 0.8
pitch_jitter = 0.05
resource_name = "tear"

[sub_resource type="Resource" id="Layer_rush"]
script = ExtResource("2_layer")
stream = ExtResource("s0")
delay = 0.2
volume_db = -4.0
pitch_jitter = 0.05
follows_pitch = false
resource_name = "rush"

[resource]
script = ExtResource("1_layers")
layers = Array[ExtResource("2_layer")]([SubResource("Layer_tear"), SubResource("Layer_rush")])
unit_size = 8.0
max_distance = 70.0
