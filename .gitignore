# Godot 4+ specific ignores
.godot/
/android/

# Godot editor temp copies of GDExtension libraries (made while the editor holds the DLL)
~*.TMP

# Python bytecode from the Blender tool scripts
__pycache__/
docs/images/graphics/scratch/
docs/sound_preview/
docs/images/walls/scratch/

# Exported builds (export_presets.cfg)
/build/

# The map editor's last terrain run (tools/map_editor/serve.py)
tools/map_editor/terrain_report.json
