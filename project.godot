; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project serotonin"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameInput="*res://scripts/autoload/game_input.gd"
Juice="*res://scripts/autoload/juice.gd"
Sfx="*res://scripts/autoload/sfx.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Skills="*res://scripts/autoload/skills.gd"
Village="*res://scripts/autoload/village.gd"
DayNight="*res://scripts/autoload/day_night.gd"
DebugMenu="*res://scripts/autoload/debug_menu.gd"
Biome="*res://scripts/autoload/biome.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
limits/global_shader_variables/buffer_size=262144
