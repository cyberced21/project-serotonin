; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project serotonin"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameInput="*res://scripts/autoload/game_input.gd"
GraphicsSettings="*res://scripts/autoload/graphics_settings.gd"
Juice="*res://scripts/autoload/juice.gd"
Sfx="*res://scripts/autoload/sfx.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
Worlds="*res://scripts/autoload/worlds.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Skills="*res://scripts/autoload/skills.gd"
Village="*res://scripts/autoload/village.gd"
DayNight="*res://scripts/autoload/day_night.gd"
PauseMenu="*res://scripts/autoload/pause_menu.gd"
DebugMenu="*res://scripts/autoload/debug_menu.gd"
Biome="*res://scripts/autoload/biome.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
limits/global_shader_variables/buffer_size=262144

[shader_globals]

detail_tex={
"type": "sampler2DArray",
"value": "res://art/textures/detail.png"
}
ground_tex={
"type": "sampler2DArray",
"value": "res://art/textures/ground.png"
}
leaf_tex={
"type": "sampler2DArray",
"value": "res://art/textures/leaves.png"
}
wind_direction={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
wind_strength={
"type": "float",
"value": 1.0
}
grass_pusher={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
